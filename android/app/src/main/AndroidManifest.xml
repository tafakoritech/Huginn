<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permission inventory (full justification in android/README.md):
        - INTERNET: required to talk to the Huginn backend.
        - POST_NOTIFICATIONS: required on Android 13+ to show follow-up/assignment
          reminders. Requested at runtime only when the user turns on reminders.
        - RECORD_AUDIO: required for Persian voice input on the Conversation
          Summary field. Requested at runtime only when the user taps the
          microphone button.
        READ_CONTACTS / WRITE_CONTACTS / READ_SMS / READ_CALL_LOG /
        READ_PHONE_STATE are intentionally NOT requested.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        Package visibility (Android 11+) for external communication apps.
    -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="ir.bale.app" />
        <package android:name="ir.pad.bale" />
        <package android:name="ir.jobinja.eitaa" />
        <package android:name="ir.irzo" />
        <package android:name="chat.rubika.ir" />
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".HuginnApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Huginn"
        tools:targetApi="31">

        <!-- WorkManager is initialized on demand through HuginnApplication (Configuration.Provider). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Huginn.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links into Huginn: huginn://lead/{id}, huginn://report/{id}, huginn://followup/{id} -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="lead"
                    android:pathPattern=".*"
                    android:scheme="huginn" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="report"
                    android:pathPattern=".*"
                    android:scheme="huginn" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="followup"
                    android:pathPattern=".*"
                    android:scheme="huginn" />
            </intent-filter>
        </activity>

        <service
            android:name="ir.tafakoritech.huginn.feature.teleprompter.TeleprompterService"
            android:exported="false" />
    </application>

</manifest>
