<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vazir (SIL OFL) — Regular weight. -->
    <font
        android:font="@font/vazir_regular"
        android:fontWeight="400"
        android:fontStyle="normal" />

    <!-- Vazir Medium weight. -->
    <font
        android:font="@font/vazir_medium"
        android:fontWeight="500"
        android:fontStyle="normal" />

    <!-- Vazir has no dedicated SemiBold cut; map 600 to the Bold file. -->
    <font
        android:font="@font/vazir_bold"
        android:fontWeight="600"
        android:fontStyle="normal" />

    <!-- Vazir Bold weight. -->
    <font
        android:font="@font/vazir_bold"
        android:fontWeight="700"
        android:fontStyle="normal" />
</font-family>
