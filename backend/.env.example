# =============================================================================
# Huginn Backend — Environment Configuration
# Copy to .env and adjust for your environment.
# NEVER commit the real .env file.
# =============================================================================

APP_NAME=huginn
APP_ENV=development
HTTP_PORT=8080
APP_TIMEZONE=Asia/Tehran

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=huginn
POSTGRES_PASSWORD=huginn
POSTGRES_DB=huginn
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=30

# --- Redis -------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_URL=amqp://huginn:huginn@localhost:5672/
RABBITMQ_USER=huginn
RABBITMQ_PASSWORD=huginn
# Job retry policy: transient failures retry with exponential backoff up to
# RABBITMQ_JOB_RETRY_LIMIT, then the message is dead-lettered to huginn.dead.
RABBITMQ_JOB_RETRY_LIMIT=5
RABBITMQ_JOB_RETRY_DELAY_MS=5000

# --- MinIO -------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=huginn
MINIO_SECRET_KEY=huginnsecret
MINIO_USE_SSL=false
MINIO_BUCKET=huginn-source-documents
MINIO_PRESIGN_TTL_HOURS=1

# --- Apache Tika -------------------------------------------------------------
TIKA_BASE_URL=http://localhost:9998

# --- Auth / JWT ---------------------------------------------------------------
# CHANGE THESE SECRETS IN PRODUCTION.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=huginn
JWT_AUDIENCE=huginn-clients
REFRESH_COOKIE_NAME=huginn_refresh

# --- LLM (OpenAI-compatible, e.g. DeepSeek) ----------------------------------
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# response_format strategy for structured outputs: auto | json_object | json_schema.
# deepseek-v4-flash rejects json_schema (HTTP 400), so pin json_object here.
LLM_STRUCTURED_OUTPUT_MODE=json_object
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_MS=500
LLM_PERSIST_PROMPTS=false
# Bounds the ENTIRE call-scenario generation operation (LLM attempt + retries +
# repair attempts + parsing). Deliberate timeout hierarchy — the outer layer
# always outlives the inner one:
#   LLM per-attempt timeout (LLM_TIMEOUT_SECONDS, 180s)
#     < operation budget (CALL_SCENARIO_OP_TIMEOUT_SECONDS, 185s)
#     < Go HTTP WriteTimeout (240s)
#     < Android/PWA call timeout (250s)
CALL_SCENARIO_OP_TIMEOUT_SECONDS=185
# Dedicated SOCKS5 proxy for OUTBOUND LLM traffic ONLY (e.g. host Xray).
# Format: host:port. Empty = direct connection. Applied explicitly to the LLM
# HTTP transport; it is NOT read from HTTP_PROXY/HTTPS_PROXY/ALL_PROXY, which
# must stay unset so internal Docker services (postgres/redis/rabbitmq/minio/
# tika) never route through the proxy.
# In Docker, use host.docker.internal to reach the host's Xray listener.
LLM_SOCKS5_PROXY=host.docker.internal:10808

# --- Storage limits ------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400

# --- Qualification ---------------------------------------------------------------
QUALIFICATION_SCORE_THRESHOLD=70

# --- Messaging (sender identity for suggested outreach messages) -----------------
# THIS identity belongs to OUR company / the salesperson sending messages.
# It is the ONLY source of the sender's identity in generated outreach.
# NEVER put a lead's company here.
MESSAGING_COMPANY_NAME=
MESSAGING_COMPANY_DESCRIPTION=
MESSAGING_SENDER_NAME=
MESSAGING_SENDER_TITLE=

# --- Muninn CRM -----------------------------------------------------------------
MUNINN_ENABLED=false
MUNINN_BASE_URL=
MUNINN_API_KEY=
MUNINN_TIMEOUT_SECONDS=30

# --- Security -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MIN=300

# --- Observability ---------------------------------------------------------------
METRICS_ENABLED=true

# --- Worker ------------------------------------------------------------------------
WORKER_NAME=worker-1

# --- Seed (DEVELOPMENT ONLY) -------------------------------------------------------
SEED_ADMIN_PASSWORD=Admin@12345
SEED_MANAGER_PASSWORD=Manager@12345
SEED_AGENT_PASSWORD=Agent@12345
