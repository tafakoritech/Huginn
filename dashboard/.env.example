# Huginn Dashboard environment configuration.
# Copy to .env.local and adjust for your environment.

# Base URL of the Huginn backend API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Application display name.
VITE_APP_NAME=Huginn

# Default UI locale: fa | en
VITE_DEFAULT_LOCALE=fa

# Default theme: light | dark
VITE_DEFAULT_THEME=light

# Development mock layer. Set to true ONLY when the backend is unavailable.
# Never enable this in production images.
VITE_USE_MOCK_API=false
